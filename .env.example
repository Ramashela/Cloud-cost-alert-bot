# Copy this file to .env for local development.
# On Render, set these as environment variables in the dashboard instead
# (render.yaml auto-generates SECRET_KEY and API_KEY for you).

# Flask session/signing secret
SECRET_KEY=change-me-to-a-random-string

# Required on every /api/* request via the "X-API-Key" header
API_KEY=change-me-api-key

# Fernet key used to encrypt stored AWS/Azure credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Local dev defaults to SQLite. On Render this is provided automatically
# by the attached Postgres database.
DATABASE_URL=sqlite:///cost_alert_bot.db

PORT=5000
